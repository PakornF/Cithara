# Cithara environment template
# This repo reads env files in two places:
# - Backend: copy backend vars into `backend/.env`
# - Frontend: copy frontend vars into `frontend/.env.local`

########################################
# Backend (Django) -> backend/.env
########################################

# SMTP (optional: if EMAIL_HOST is empty, Django prints verification emails to console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cithara <noreply@cithara.local>

# Suno API
SUNO_AI_API_KEY=
SUNO_API_BASE_URL=https://api.sunoapi.org

# Optional/future hardening (currently hardcoded in backend/cithara/settings.py)
# SECRET_KEY=django-insecure-change-me-in-production
# DEBUG=true
# ALLOWED_HOSTS=127.0.0.1,localhost

########################################
# Frontend (Next.js) -> frontend/.env.local
########################################

NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
