# SMTP (optional)
# If EMAIL_HOST is empty, Django will print verification emails to console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cithara <noreply@cithara.local>

# Song generation strategy: "mock" (default, no API key needed) or "suno" (real AI)
GENERATOR_STRATEGY=mock

# Suno API — only required when GENERATOR_STRATEGY=suno
# Get your key at: https://sunoapi.org
SUNO_AI_API_KEY=
SUNO_API_BASE_URL=https://api.sunoapi.org
